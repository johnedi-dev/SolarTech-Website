# Netlify / Cloudflare Pages redirects
# Normalize the calculator URL to its canonical (trailing-slash) form
/solar-calculator    /solar-calculator/    301
/#/solar-calculator  /solar-calculator/    301

# Force one version of the home page
/index.html    /    301
/privacy       /privacy.html    301
/terms         /terms.html      301

# Long-lived caching for hashed build assets (safe: filename changes when content changes)
/assets/*  Cache-Control: public, max-age=31536000, immutable  200
